{
  "name": "@commercelayer/sdk-utils",
  "version": "5.0.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "scripts": {
    "generate": "tsx gen/generator.ts && biome format --write src/helpers",
    "lint": "biome check --enforce-assist=true",
    "ts:check": "tsc -p tsconfig.check.json",
    "check": "biome check --enforce-assist=true --write",
    "build": "tsup",
    "test": "vitest",
    "test-local": "tsx test/spot.ts",
    "test-webhook": "tsx test/webhook.ts",
    "coverage": "vitest run --coverage",
    "clean": "pnpx rimraf --glob **/node_modules **/pnpm-lock.yaml",
    "dep:semver": "pnpm dlx npm-check-updates --packageFile '**/package.json' -t semver -u",
    "release": "pnpm upgrade && pnpm generate && pnpm lint && pnpm build && pnpm test",
    "release:version": "node scripts/release-version.mjs"
  },
  "keywords": [
    "javascript",
    "ecommerce",
    "jamstack",
    "commercelayer"
  ],
  "author": "Pierluigi Viti <pierluigi@commercelayer.io>",
  "license": "MIT",
  "description": "Commerce Layer Javascript SDK Utils library",
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commercelayer/js-auth": "^8.0.1",
    "@commercelayer/sdk": "^8.0.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.5",
    "jsonapi-typescript": "^0.1.3",
    "lefthook": "^2.1.17",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@commercelayer/sdk": "^8.0.0"
  },
  "repository": "github:commercelayer/commercelayer-sdk-utils",
  "publishConfig": {
    "access": "public"
  }
}
